{
  "name": "gralia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev:demo",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "dev:supabase": "vite --mode supabase --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/src cypress scripts *.ts *.js",
    "test:unit": "vitest run",
    "test:e2e:demo": "node scripts/e2e.mjs demo",
    "test:e2e:supabase": "node scripts/e2e.mjs supabase",
    "test:db": "node supabase/tests/run.mjs",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "build:supabase": "npm run typecheck && vite build --mode supabase",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "cypress": "15.21.2",
    "cypress-axe": "1.7.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
